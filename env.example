# env.example - a minimal profile for building a tree that is NOT the login directory
# (HOME=/path/to/tree make).  A project login uses the base dotfiles instead: .profile,
# .bash_profile and .bashrc in the project root (see README "Project-per-login model").
# Contains NO secrets; keep keys and passwords out of the project tree (the .gitignore
# excludes .env, .secrets, *.key, *.pem, .profile.local, .bashrc.local).
#
# rules.mak finds the project through ~ : use the project directory as HOME, or run
#   HOME=/path/to/project make
export CC=gcc
export CXX=g++
export PATH="$HOME/bin:$PATH"
export LD_LIBRARY_PATH="$HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"   # only for shared libs (off by default)
# run time paths used by sys/far/msg/map (all under run/):
export FILE_PATH="$HOME/run/"
export DATA_PATH="$HOME/run/"
export PIPE_PATH="$HOME/run/pipes/"
export MEMORY_PATH="$HOME/run/"
export ELOG_FILE="$HOME/run/event.log"
# export PROJECT=myproject       # used by the proj source control tools
# export PEERS="host1 host2"     # only for make copy_to_peer

# UNITS: the units of the project.  The master makefile writes them to units.mak (in the project
# root, dependency order) and ignores any UNITS in the environment; this line makes the shell see
# the same list.  When make says "UNITS changed, run: source ~/.bash_profile", re-source this file.
if [ -f "$HOME/units.mak" ]; then
	UNITS=$(sed -n 's/^UNITS[[:space:]]*:\{0,1\}=[[:space:]]*//p' "$HOME/units.mak")
else
	UNITS=$(ls "$HOME"/*/[Mm]akefile 2>/dev/null | sed 's#.*/\([^/]*\)/[Mm]akefile#\1#' | sort -u | tr '\n' ' ')
fi
export UNITS
# starting a new project: the project worker has the starter list ("project NONE"), the catalog
# worker has the URLs of the public units.  A plain "make" in a fresh clone does the rest.
# export PROJECT_WORKER_URL=https://<project worker>
# export UNITS_CATALOG_URL=https://<catalog worker>
