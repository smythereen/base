#!/bin/bash
# SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later
# Copyright (c) 2026 John R. Smythe Jr.
#
# Write a complete fresh ~/.bash_profile for a project-as-login tree.
# ROOT is $HOME (each project is its own login). Overwrites; no backup.
#
set -euo pipefail

ROOT="${HOME}"
PROFILE="${ROOT}/.bash_profile"

cat > "${PROFILE}" << 'PROFILE_EOF'
# Generated by bin/profile_add — project-per-login profile.
# ROOT is $HOME (this project's home directory).

# PATH: project bin first, then cargo (rustc/bindgen), then system
PATH="${HOME}/bin:${HOME}/.cargo/bin:${PATH}"
export PATH

# Shared libraries built into ~/lib
LD_LIBRARY_PATH="${HOME}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export LD_LIBRARY_PATH

# Compilers
CC="${CC:-gcc}"
CXX="${CXX:-g++}"
export CC CXX

# Runtime paths used by public units (sys/map/mio/msg via getenv / File_Path):
#   MEMORY_PATH  — map shared-memory files under run/
#   FILE_PATH    — sys print/file defaults
#   ELOG_FILE    — sys event log
#   DATA_PATH    — general data under run/
#   PIPE_PATH    — named pipes
#   MEMORY_ALL   — mio: when set, show input-only / display-only fields
#   TraceLevel   — msg: hex trace mask (optional; leave empty for defaults)
#   DATABASE_DIR — sql session map (HOME-based default; unused if sql absent)
ELOG_FILE="${HOME}/run/event.log"
export ELOG_FILE
FILE_PATH="${HOME}/run/"
export FILE_PATH
DATA_PATH="${HOME}/run/"
export DATA_PATH
PIPE_PATH="${HOME}/run/pipes/"
export PIPE_PATH
MEMORY_PATH="${HOME}/run/"
export MEMORY_PATH
# MEMORY_ALL=1
# TraceLevel=0x00000000
DATABASE_DIR="${HOME}/run/database"
export DATABASE_DIR

mkdir -p "${HOME}/run" "${HOME}/run/pipes" "${HOME}/run/database" \
	"${HOME}/bin" "${HOME}/lib" "${HOME}/cmn" "${HOME}/tmp" "${HOME}/log" \
	"${HOME}/hlp" 2>/dev/null || true

# UNITS: match units.mak when present (same list make uses)
if [ -f "${HOME}/units.mak" ]; then
	UNITS=$(sed -n 's/^UNITS[[:space:]]*:\{0,1\}=[[:space:]]*//p' "${HOME}/units.mak")
else
	UNITS=$(ls "${HOME}"/*/[Mm]akefile 2>/dev/null | sed 's#.*/\([^/]*\)/[Mm]akefile#\1#' | sort -u | tr '\n' ' ')
fi
export UNITS

# Optional interactive bashrc
if [ -f "${HOME}/.bashrc" ]; then
	# shellcheck disable=SC1091
	. "${HOME}/.bashrc"
fi

# Non-fatal toolchain hints (Rust is optional; RS_BINDGEN=auto)
if ! command -v rustc >/dev/null 2>&1; then
	echo "warning: rustc not found in PATH (Rust unit builds need it; C/C++ still work)" >&2
fi
if ! command -v bindgen >/dev/null 2>&1; then
	echo "warning: bindgen not found in PATH (RS_BINDGEN=auto skips generation)" >&2
fi
PROFILE_EOF

chmod 644 "${PROFILE}"
echo "wrote ${PROFILE} (ROOT=${ROOT})"
echo "re-login (or: source ${PROFILE}) then: make"
