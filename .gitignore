# build output (UNITS.md section 7)
*.o
*.a
*.so
*.rlib
*.d
.depend
*.tmp
*.log
core.*
# installed products (re-created by make)
/bin/*
/lib/*
/lib64/
/cmn/*
/run/*
/tmp/*
/log/*
!/bin/.gitkeep
!/lib/.gitkeep
!/cmn/.gitkeep
!/cmn/LICENSE
!/run/.gitkeep
!/tmp/.gitkeep
!/log/.gitkeep
# fetched units are separate git clones: list them in .git/info/exclude of the project tree
# the project's own lists live in the project root, never in repo/ (the repo unit is public and
# shared by all projects).  They belong to the project, not to the base repo; the *.example files
# are tracked.
/project.repos
/project.repos.lock
/project.repos.new
/private.units
/private.units.new
/.rebuild-needed
/units.mak
/units.mak.new
/.built
/.old/
# secrets and personal files: never commit
.env
.secrets/
*.key
*.pem
# the project dotfiles (.profile .bash_profile .bashrc) are tracked; personal and
# secret settings go in these, which are not
.profile.local
.bashrc.local
*.save
*.old
.old/
